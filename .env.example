# Neon Postgres — connection string from https://console.neon.tech
# En local apunta SIEMPRE a la rama `dev` de Neon, nunca a producción.
# La URL de producción vive en Vercel env; en local se guarda aparte como
# DATABASE_URL_PROD y usarla (migraciones de prod) es un acto deliberado:
#   DATABASE_URL=$DATABASE_URL_PROD pnpm db:migrate
DATABASE_URL=
DATABASE_URL_PROD=

# Better-Auth — generate secret: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# S3 — almacenamiento privado de PDFs de factura (bucket en región UE)
S3_REGION=eu-west-3
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Opcional: endpoint S3-compatible (Cloudflare R2, MinIO). Vacío = AWS S3.
S3_ENDPOINT=

# Resend — reminder sending (week 2). Sin esta clave, el envío usa transporte
# dry-run (loguea en vez de enviar). Con ella, envía de verdad automáticamente.
RESEND_API_KEY=
# Remitente de los recordatorios (interino, hasta verificación de dominio por
# usuario). Debe ser de un dominio verificado en Resend cuando envíes de verdad.
REMINDER_FROM_EMAIL=recordatorios@tudominio.com
# Secreto de firma (whsec_...) del webhook de Resend → /api/webhooks/resend.
# Se obtiene al crear el webhook en Resend; sin él, el endpoint responde 503.
RESEND_WEBHOOK_SECRET=

# Stripe — subscription billing (week 3)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Cron — protects /api/cron endpoints
CRON_SECRET=

# Meta Ads — medición de la publicidad. Sin estas claves no se carga el píxel
# ni se envía nada por la Conversions API: el sitio funciona igual.
# ID del dataset (píxel) de Events Manager. PÚBLICA: se inyecta en el bundle
# del navegador, así que cambiarla en Vercel exige un redeploy.
NEXT_PUBLIC_META_PIXEL_ID=2707571534364000
# Token de acceso de la Conversions API (Events Manager > Configuración).
# SECRETO: nunca con prefijo NEXT_PUBLIC_.
META_CAPI_TOKEN=token
# Token de verificación del dominio en Meta Business. Si está vacío no se emite
# la etiqueta <meta name="facebook-domain-verification">.
META_DOMAIN_VERIFICATION=token
# Código de la pestaña "Test Events" para depurar la CAPI. Solo en local o
# preview: en producción tiene que estar vacío o los eventos no cuentan.
META_CAPI_TEST_EVENT_CODE=TEST11385

# Cifrado del borrador de burofax (AES-256-GCM). Los datos del deudor —un
# tercero que nunca ha visitado Cobra— viven cifrados como mucho 72 horas,
# hasta que su acreedor los reclama desde el enlace del correo.
# Genera la clave con: openssl rand -base64 32
BUROFAX_PAYLOAD_KEY=
